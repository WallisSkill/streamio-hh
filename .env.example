PORT=7000
ADDON_BASE_URL=

# Nguồn phát (API mở, trả link m3u8 trực tiếp)
KKPHIM_API=https://phimapi.com
OPHIM_API=https://ophim1.com

# Nguon C: phat truc tiep duoc, nhung segment doi Referer nen phai di qua
# STREMIO_PROXY ben duoi.
NGUONC_API=https://phim.nguonc.com
# Cloudflare cua nguonc chan IP datacenter (Vercel...), nen tren serverless
# nguon nay tu tat. Tro bien duoi day toi mot ban addon chay o nha thi lenh goi
# API di vong qua do bang IP dan cu, va Nguon C tu bat lai. Chi du lieu API di
# duong nay; video van di thang tu may nguoi xem toi CDN cua Nguon C.
# Vi du: NGUONC_UPSTREAM=https://home.example.com
NGUONC_UPSTREAM=
# Duong lui khi upstream khong tra loi (may o nha tat). La mot mau URL co {url}.
# Ha tang cua nguoi khac, dung cho viec khong phai cua no, nen coi la tam bo:
# ho chan hoac doi tham so luc nao cung duoc. De rong thi khong dung duong nay.
# Vi du: NGUONC_PROXY=https://<fetcher>/?url={url}
# (sc.k-20.xyz trong vi du cu da chet, do 21/09/2026)
NGUONC_PROXY=

# HH3D: phat truc tiep 1080p, khong can STREMIO_PROXY (segment khong doi header).
# Ten mien hay doi, bit.ly/hh3d luon tro ve ban dang song.
HH3D_BASE=https://hoathinh3d.de

ENABLE_KKPHIM=1
ENABLE_OPHIM=1
ENABLE_NGUONC=1
ENABLE_HH3D=1

# Embed: doi link embed thanh link phat duoc trong Stremio khi trang embed
# cong bo link do. Tat bang RESOLVE_EMBEDS=0.
RESOLVE_EMBEDS=1
# Chi duoc phep tai trang embed cua nhung host nay (chan SSRF).
EMBED_HOSTS=player.phimapi.com,streamc.xyz
# Link embed hay kem token ngan han, nen cache rieng va ngan hon.
EMBED_TTL=300
# Mot ban addon nua o cho Cloudflare KHONG dung truoc (vi du Vercel). Chi can
# tren Cloudflare Workers: streamc tra 403 cho moi request tu Worker, nen ban
# tren Workers phai nho ban kia phuc vu /hls.m3u8. De rong thi tap Nguon C ra
# dang link mo trang.
# Vi du: STREAMC_UPSTREAM=
# Ghi de bang "server embed -> CDN segment" khi ho doi CDN. Chi can khi Nguon C
# dung phat va /probe/embed bao khong tim ra video.
# Vi du: STREAMC_SEGMENT_HOSTS=embed12=cyin1.sbs,embed13=thais.hihihoho3.top
STREAMC_SEGMENT_HOSTS=https://stremio-vn-addon.vercel.app
STREAMC_UPSTREAM=
# Ghi de bang "server embed -> CDN segment" khi ho doi CDN. Chi can khi Nguon C
# dung phat va /probe/embed bao khong tim ra video.
# Vi du: STREAMC_SEGMENT_HOSTS=embed12=cyin1.sbs,embed13=thais.hihihoho3.top
STREAMC_SEGMENT_HOSTS=

# Server noi bo cua Stremio, chay tren MAY DANG XEM (khong phai may chay addon).
# Link duoc boc qua no de moi request mang theo Referer/Origin cua Nguon C.
# Nguon C chi phat duoc qua duong nay: segment cua no tra 403 cho request khong
# co Referer. De rong thi tap Nguon C quay ve dang link mo ngoai.
STREMIO_PROXY=http://127.0.0.1:11470

# Dong "mo trang" cho tap khong phat duoc trong Stremio (Nguon C khi khong lay
# duoc link, HH3D). Mac dinh 0: bam vao la bi da ra trinh duyet. Bat = 1 neu
# muon co con hon khong.
SHOW_LINK_ROWS=0

CACHE_TTL=1800
